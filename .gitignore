# Source point clouds -- large, immutable, re-downloadable from 3DEP
data/raw/

# Derived rasters regenerate from the pipeline scripts; only prose and
# assembled deliverables in output/reports/ are tracked.
# Note: this must be output/* + a negation, NOT a bare output/ exclude --
# git will not traverse into a fully-excluded directory to find negation
# rules inside it (verified in project 1 with git check-ignore).
output/*
!output/reports/

__pycache__/
*.pyc

# Claude Code config: track the policy, never the accumulated local allows.
# NOTE: must be '.claude/*' plus negations, not '.claude/' -- git does not
# traverse into a fully-excluded directory to find negation rules inside.
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/hooks/last_number_audit.txt

# The non-deliverable marker is tracked; the renders themselves are not.
!output/renders_personal/
output/renders_personal/*
!output/renders_personal/README.md
